<!DOCTYPE html>
<html>
    <head>
        <title>Weather Check</title>
        <link rel="stylesheet" type="text/css" href="/main.css" />
        <link rel="stylesheet" type="text/css" href="/weather.css" />
    </head>
    <body>
        <div class="weather-container">
            <h1>Check the Weather</h1>
            <p>Enter a city name to see the current weather:</p>
            <form action="/weather/result" method="GET" class="weather-form">
                <input type="text" name="city" placeholder="Enter city name" required class="weather-input" />
                <input type="submit" value="Get Weather" class="weather-button" />
            </form>
            <div style="margin-top: 20px">
                <a href="/" class="back-link">Home</a>
            </div>
        </div>
    </body>
</html>
